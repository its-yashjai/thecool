# Copy to .env.local and fill in. Never commit real keys, never paste them into chats or logs.
PORT=3000

# --- Moss (https://moss.dev): retrieval -------------------------------------
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
# Existing index to reuse, or a new name to create (free tier allows 3 indexes).
# The app only ever creates the index or upserts documents; it never deletes anything.
MOSS_INDEX_NAME=neuralflow-kb
# Embedding model used only when the app CREATES the index (default moss-minilm). Example: moss-mediumlm
# MOSS_MODEL_ID=
# If Moss's model download fails (HTTP 401 on models.moss.link), use local embeddings:
#   MOSS_EMBEDDINGS=local
#   MOSS_INDEX_NAME=<a NEW index name, e.g. neural-byo>
#   (also run: npm install @huggingface/transformers)
# MOSS_EMBEDDINGS=moss
# EMBED_MODEL=Xenova/all-MiniLM-L6-v2
# 0 = keyword only, 1 = semantic only (default 0.7)
# MOSS_ALPHA=0.7

# --- LiveKit Cloud (https://cloud.livekit.io): voice room --------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=neuralflow-ops

# --- LLM (optional, any OpenAI-compatible API) --------------------------------
# Only used to phrase answers to open questions, grounded in Moss documents.
# Commands ("start simulation", "emergency cooling") never depend on it.
# Groq example:
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_TIMEOUT_MS=6000
