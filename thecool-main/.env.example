# Copy to .env.local and fill in. Never commit real keys, never paste them into chats or logs.
# On Render: set these in Dashboard → Environment (not in repo). Rotate MOSS_PROJECT_KEY there anytime without code change.
PORT=3000

# --- Moss (https://moss.dev): retrieval -------------------------------------
# Required for semantic search. If quota is exhausted you will see "LOCAL KEYWORD FALLBACK" — app still works, just keyword-only.
# v7 uses 96 docs, local embeddings, semantic hybrid. Keep MOSS_INDEX_NAME stable after first deploy.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
# Existing index to reuse, or a new name to create (free tier allows 3 indexes).
# The app only ever creates the index or upserts documents; it never deletes anything.
MOSS_INDEX_NAME=neuralflow-kb
# Embedding model used only when the app CREATES the index (default moss-minilm). Example: moss-mediumlm
# MOSS_MODEL_ID=
# v7 default: local embeddings (Xenova/all-MiniLM-L6-v2) — avoids Moss model download 401 and keeps p50 ~2-6ms.
#   MOSS_EMBEDDINGS=local  (recommended for Render)
#   Use a NEW MOSS_INDEX_NAME when switching to local (e.g. neuralflow-kb)
# MOSS_EMBEDDINGS=moss
# EMBED_MODEL=Xenova/all-MiniLM-L6-v2
# 0 = keyword only, 1 = semantic only (default 0.7)
# MOSS_ALPHA=0.7

# --- LiveKit Cloud (https://cloud.livekit.io): voice room --------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=neuralflow-ops

# --- LLM (optional, any OpenAI-compatible API) --------------------------------
# Only used to phrase answers to open questions, grounded in Moss documents.
# Commands ("start simulation", "emergency cooling") never depend on it.
# HiDevs (Gemini 3.6 Flash) example:
# LLM_API_KEY=your_hidevs_api_key
# LLM_BASE_URL=https://llm.hidevs.xyz/v1
# LLM_MODEL=gemini-3.6-flash
# LLM_TIMEOUT_MS=6000
