# NeuralFlow environment variables
PORT=3000
NODE_ENV=development

# Moss Zero-Vector-DB (YC F25) — get credentials at https://moss.dev
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=neuralflow-ops-v1

# LiveKit (real-time WebRTC voice) — get credentials at https://livekit.io
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# OpenAI / LLM (for voice agent brain) — get key at https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1