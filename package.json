{
  "name": "neuralflow",
  "version": "1.0.0",
  "description": "NeuralFlow - Physics-Informed Neural Network for proactive GPU thermal management and cooling optimization by Yash Jai",
  "author": "Yash Jai <yashjaimail@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/its-yashjai/thecool.git"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "check:moss": "tsx scripts/check-moss.ts",
    "seed:moss": "tsx scripts/check-moss.ts",
    "typecheck": "tsc --noEmit",
    "check:llm": "tsx scripts/check-llm.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@moss-dev/moss": "^1.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.0",
    "express": "^4.21.2",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.0",
    "lucide-react": "^1.16.0",
    "openai": "^7.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
